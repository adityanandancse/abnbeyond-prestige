  {
    "name": "WhatsApp concierge",
    "settings": [
      {
        "type": "checkbox",
        "id": "whatsapp_enable",
        "label": "Enable WhatsApp concierge",
        "default": true
      },
      {
        "type": "text",
        "id": "whatsapp_phone",
