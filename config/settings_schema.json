  {
    "name": "Made to measure",
    "settings": [
      {
        "type": "paragraph",
        "content": "Controls the custom-size form on product pages. The field keys and garment map are edited in snippets/mtm-fields.liquid."
      },
      {
        "type": "text",
        "id": "men_tag",
        "label": "Menswear tag",
