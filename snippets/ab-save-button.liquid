{%- comment -%}
  Save-to-board button. Enhanced by assets/ab-board.js (loaded on product,
  collection and board pages). Renders without JS too — it just won't act until
  the module runs. aria-pressed reflects the saved state (set by the module).

  Params:
    product  — the product
    context  — 'product' (inline text button under Add to cart) or 'card'
{%- endcomment -%}

{%- assign ab_ctx = context | default: 'product' -%}

{%- if ab_ctx == 'card' -%}
  <button type="button"
          class="AbSave AbSave--card"
          data-ab-save
          data-handle="{{ product.handle }}"
          data-title="{{ product.title | escape }}"
          data-label-default="Save"
          data-label-saved="Saved"
          aria-pressed="false"
          aria-label="Save {{ product.title | escape }}">
    <span class="AbSave__Heart" aria-hidden="true">
      <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
        <path d="M12 20.5l-1.3-1.17C6.05 15.14 3 12.38 3 8.98 3 6.2 5.17 4 7.95 4c1.57 0 3.08.73 4.05 1.88C12.97 4.73 14.48 4 16.05 4 18.83 4 21 6.2 21 8.98c0 3.4-3.05 6.16-7.7 10.35L12 20.5z"/>
      </svg>
    </span>
  </button>
{%- else -%}
  <button type="button"
          class="AbSave AbSave--inline"
          data-ab-save
          data-handle="{{ product.handle }}"
          data-title="{{ product.title | escape }}"
          data-label-default="Save"
          data-label-saved="Saved"
          aria-pressed="false"
          aria-label="Save {{ product.title | escape }}">
    <span class="AbSave__Glyph" data-ab-save-glyph aria-hidden="true">&#9825;</span>
    <span data-ab-save-label>Save</span>
  </button>
{%- endif -%}
