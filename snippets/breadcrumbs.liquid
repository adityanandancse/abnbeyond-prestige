{%- comment -%}
  Visible breadcrumbs (no JSON-LD — that is built by snippets/schema-graph.liquid
  from the SAME trail, snippets/breadcrumb-trail.liquid, so the two always match).
  Quiet style using theme tokens. Gated by settings.show_breadcrumbs upstream.
{%- endcomment -%}

{%- include 'breadcrumb-trail' -%}

{%- if bc_render -%}
  <nav class="Breadcrumb" aria-label="Breadcrumb">
    <ol class="Breadcrumb__List">
      {%- assign bc_lines = bc_trail | strip | split: '
' -%}
      {%- for line in bc_lines -%}
        {%- assign line = line | strip -%}
        {%- if line == blank -%}{%- continue -%}{%- endif -%}
        {%- assign parts = line | split: '|~|' -%}
        {%- assign crumb_name = parts[0] | strip -%}
        {%- assign crumb_url = parts[1] | strip -%}
        {%- if crumb_url != blank -%}
          <li class="Breadcrumb__Item"><a href="{{ crumb_url }}">{{ crumb_name | escape }}</a></li>
        {%- else -%}
          <li class="Breadcrumb__Item" aria-current="page">{{ crumb_name | escape }}</li>
        {%- endif -%}
      {%- endfor -%}
    </ol>
  </nav>

  <style>
    .Breadcrumb { margin: 20px 0 0; }
    .Breadcrumb__List {
      display: flex; flex-wrap: wrap; align-items: center;
      list-style: none; margin: 0; padding: 0;
      font-size: 11px; letter-spacing: 0.08em;
    }
    .Breadcrumb__Item { color: {{ settings.text_light_color | default: '#3A3A38' }}; }
    .Breadcrumb__Item a { color: inherit; text-decoration: none; }
    .Breadcrumb__Item a:hover { text-decoration: underline; }
    .Breadcrumb__Item[aria-current="page"] { color: {{ settings.text_color | default: '#141414' }}; }
    .Breadcrumb__Item + .Breadcrumb__Item::before {
      content: '\203A'; margin: 0 8px; color: {{ settings.text_light_color | default: '#3A3A38' }};
    }
  </style>
{%- endif -%}
