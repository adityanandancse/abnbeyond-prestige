{%- comment -%}
  Open Graph + Twitter social preview tags. One og:image (https, 1200w) with
  width/height/alt; twitter card summary_large_image. Product price is emitted
  only for products that are not tagged price-on-request.
{%- endcomment -%}

{%- comment -%} ---- Resolve type, image and copy per template ---- {%- endcomment -%}
{%- assign og_type = 'website' -%}
{%- assign og_image = settings.share_image | default: settings.brand_logo -%}
{%- assign og_title = page_title -%}
{%- assign og_description = page_description | default: shop.description -%}

{%- if template.name == 'product' -%}
  {%- assign og_type = 'product' -%}
  {%- assign og_image = product.featured_image | default: settings.share_image -%}
  {%- assign og_title = product.title -%}
  {%- assign og_description = product.description | default: page_description | default: shop.description -%}
{%- elsif template.name == 'article' -%}
  {%- assign og_type = 'article' -%}
  {%- assign og_image = article.image | default: settings.share_image -%}
  {%- assign og_title = article.title -%}
  {%- assign og_description = article.excerpt_or_content | default: page_description -%}
{%- elsif template.name == 'collection' -%}
  {%- assign og_image = collection.image | default: collection.products.first.featured_image | default: settings.share_image -%}
  {%- assign og_title = collection.title -%}
  {%- assign og_description = collection.description | default: page_description | default: shop.description -%}
{%- endif -%}

<meta property="og:site_name" content="{{ settings.brand_name | default: shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | strip_html | escape }}">
<meta property="og:type" content="{{ og_type }}">

{%- if og_description != blank -%}
  <meta property="og:description" content="{{ og_description | strip_html | strip_newlines | truncate: 200 | escape }}">
{%- endif -%}

{%- if og_image != blank -%}
  {%- assign og_image_alt = og_image.alt | default: og_title | default: shop.name -%}
  <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  {%- if og_image.aspect_ratio > 0 -%}
    <meta property="og:image:height" content="{{ 1200 | divided_by: og_image.aspect_ratio | round }}">
  {%- endif -%}
  <meta property="og:image:alt" content="{{ og_image_alt | strip_html | escape }}">
{%- endif -%}

{%- if template.name == 'product' -%}
  {%- assign por_tags = product.tags | join: ',' | downcase -%}
  {%- unless por_tags contains 'price-on-request' -%}
    <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html | escape }}">
    <meta property="og:price:currency" content="{{ shop.currency }}">
  {%- endunless -%}
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | strip_html | escape }}">
{%- if og_description != blank -%}
  <meta name="twitter:description" content="{{ og_description | strip_html | strip_newlines | truncate: 200 | escape }}">
{%- endif -%}
{%- if og_image != blank -%}
  <meta name="twitter:image" content="https:{{ og_image | image_url: width: 1200 }}">
{%- endif -%}
