{%- assign anim = 'scroll-left' -%}
{%- if section.settings.direction == 'right' -%}
  {%- assign anim = 'scroll-right' -%}
{%- endif -%}

<section class="CelebCarousel"
         style="background-color: {{ section.settings.bg_color }};
                padding: {{ section.settings.padding_vertical }}px 0;
                {% if section.settings.border_width > 0 %}border-top: {{ section.settings.border_width }}px solid {{ section.settings.border_color }}; border-bottom: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};{% endif %}">

  {%- if section.settings.title != blank -%}
    <p class="CelebCarousel__Title">{{ section.settings.title | escape }}</p>
  {%- endif -%}

  <div class="CelebCarousel__Track CelebCarousel__Track--{{ anim }}"
       style="gap: {{ section.settings.image_spacing }}px;
              animation-duration: {{ section.settings.scroll_speed }}s;">

    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.carousel_image != blank -%}
          {%- assign img = block.settings.carousel_image -%}
          {%- assign h = section.settings.image_height -%}
          {%- assign w = h | times: img.aspect_ratio | round -%}

          <div class="CelebCarousel__Item" style="height: {{ h }}px;" {% if i == 2 %}aria-hidden="true"{% endif %}>
            {%- if block.settings.carousel_link != blank -%}
              <a href="{{ block.settings.carousel_link }}" {% if i == 2 %}tabindex="-1"{% endif %}>
                <img src="{{ img | img_url: '800x' }}"
                     width="{{ w }}" height="{{ h }}"
                     loading="lazy"
                     {% if i == 2 %}alt=""{% else %}alt="{{ block.settings.image_alt | default: img.alt | escape }}"{% endif %}>
              </a>
            {%- else -%}
              <img src="{{ img | img_url: '800x' }}"
                   width="{{ w }}" height="{{ h }}"
                   loading="lazy"
                   {% if i == 2 %}alt=""{% else %}alt="{{ block.settings.image_alt | default: img.alt | escape }}"{% endif %}>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .CelebCarousel {
    width: 100%;
    overflow: hidden;
    position: relative;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .CelebCarousel__Title {
    text-align: center;
    margin: 0 0 20px;
    font-size: 11px;
    letter-spacing: 0.08em;
    font-weight: 500;
    text-transform: uppercase;
    color: {{ section.settings.title_color }};
  }

  #shopify-section-{{ section.id }} .CelebCarousel__Track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  #shopify-section-{{ section.id }} .CelebCarousel__Track--scroll-left {
    animation-name: celeb-scroll-{{ section.id }};
  }

  #shopify-section-{{ section.id }} .CelebCarousel__Track--scroll-right {
    animation-name: celeb-scroll-{{ section.id }};
    animation-direction: reverse;
  }

  @keyframes celeb-scroll-{{ section.id }} {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  #shopify-section-{{ section.id }} .CelebCarousel__Item {
    flex: 0 0 auto;
  }

  #shopify-section-{{ section.id }} .CelebCarousel__Item img {
    display: block;
    height: 100%;
    width: auto;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .CelebCarousel__Item {
      height: {{ section.settings.image_height_mobile }}px !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .CelebCarousel__Track {
      animation: none;
      overflow-x: auto;
    }
  }
</style>

{% schema %}
{
  "name": "Celebrity carousel",
  "settings": [
    { "type": "header", "content": "Content" },
    {
      "type": "text",
      "id": "title",
      "label": "Label above the row",
      "info": "Optional. Renders in small capitals.",
      "default": "Seen"
    },
    { "type": "color", "id": "title_color", "label": "Label colour", "default": "#3A3A38" },
    { "type": "header", "content": "Appearance" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#141414" },
    { "type": "range", "id": "padding_vertical", "label": "Vertical padding", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 40 },
    { "type": "range", "id": "border_width", "label": "Border width", "min": 0, "max": 10, "step": 1, "unit": "px", "default": 0 },
    { "type": "color", "id": "border_color", "label": "Border colour", "default": "#3A3A38" },
    { "type": "header", "content": "Carousel" },
    { "type": "range", "id": "scroll_speed", "label": "Scroll speed", "min": 5, "max": 120, "step": 5, "unit": "sec", "default": 60 },
    { "type": "range", "id": "image_height", "label": "Image height, desktop", "min": 200, "max": 800, "step": 10, "unit": "px", "default": 300 },
    { "type": "range", "id": "image_height_mobile", "label": "Image height, mobile", "min": 120, "max": 500, "step": 10, "unit": "px", "default": 220 },
    { "type": "range", "id": "image_spacing", "label": "Spacing between images", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 25 },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll direction",
      "options": [
        { "value": "left", "label": "Left to right" },
        { "value": "right", "label": "Right to left" }
      ],
      "default": "left"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "carousel_image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Who is in this image", "info": "Used as alt text. Name and occasion." },
        { "type": "url", "id": "carousel_link", "label": "Link to the piece" }
      ]
    }
  ],
  "presets": [
    { "name": "Celebrity carousel", "category": "Image" }
  ]
}
{% endschema %}