{%- comment -%}
  AB & Beyond — homepage FAQ (AEO).
  Reuses the theme's .Faq accordion (data-section-type="faq") and outputs
  FAQPage JSON-LD from the same blocks, so search and AI engines read exactly
  what shoppers see. Use on the homepage only; the FAQ page has its own.
{%- endcomment -%}
<section class="Section Section--spacingNormal" data-section-type="faq" data-section-id="{{ section.id }}">
  <div class="Container">
    <header class="SectionHeader SectionHeader--center">
      {%- if section.settings.subheading != blank -%}
        <h3 class="SectionHeader__SubHeading Heading u-h6">{{ section.settings.subheading | escape }}</h3>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="SectionHeader__Heading Heading u-h1">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
    </header>

    <div class="PageContent PageContent--narrow">
      <div class="Faq">
        {%- for block in section.blocks -%}
          <div class="Faq__Item {% if forloop.last %}Faq__Item--lastOfSection{% endif %}" aria-expanded="false" {{ block.shopify_attributes }}>
            <span class="Faq__Icon">{% include 'icon' with 'select-arrow-right' %}</span>
            <div class="Faq__ItemWrapper">
              <button class="Faq__Question">{{ block.settings.title | escape }}</button>
              <div class="Faq__AnswerWrapper" aria-hidden="true">
                <div class="Faq__Answer Rte">{{ block.settings.answer }}</div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.link_text != blank and section.settings.link_url != blank -%}
        <div class="SectionFooter">
          <a href="{{ section.settings.link_url }}" class="Button Button--secondary">{{ section.settings.link_text | escape }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
{%- for block in section.blocks -%}{"@type":"Question","name":{{ block.settings.title | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | strip_newlines | json }}}}{% unless forloop.last %},{% endunless %}{%- endfor -%}
]}
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ (with schema)",
  "class": "shopify-section--bordered",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "subheading", "label": "Sub-heading", "default": "Good to know" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Questions, answered" },
    { "type": "text", "id": "link_text", "label": "Button text", "default": "All questions" },
    { "type": "url", "id": "link_url", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "title", "label": "Question", "default": "Do you have a question?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer in one or two direct sentences first, then any detail.</p>" }
      ]
    }
  ],
  "presets": [
    { "category": "Text", "name": "FAQ (with schema)" }
  ]
}
{% endschema %}
