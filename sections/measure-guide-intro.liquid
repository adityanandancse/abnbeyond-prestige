{%- comment -%}
  ============================================================================
  How-to-measure guide — intro + jump nav.
  Sits above the two measure-guide sheets (id="he" / id="she") and links to
  them. General tips live here so each sheet stays focused on single measures.
  ============================================================================
{%- endcomment -%}

<section class="MeasureIntro">
  <div class="Container">
    <header class="MeasureIntro__Header">
      {%- if section.settings.heading != blank -%}
        <h1 class="MeasureIntro__Title Heading u-h1">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="MeasureIntro__Lead Rte">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>

    <nav class="MeasureIntro__Nav" aria-label="Measurement sheets">
      <a class="MeasureIntro__Jump Button Button--secondary" href="#he">Menswear</a>
      <a class="MeasureIntro__Jump Button Button--secondary" href="#she">Womenswear</a>
    </nav>

    {%- if section.settings.tips != blank -%}
      <div class="MeasureIntro__Tips Rte">{{ section.settings.tips }}</div>
    {%- endif -%}
  </div>
</section>

<style>
  .MeasureIntro { padding: 56px 0 8px; }
  .MeasureIntro__Header { max-width: 720px; margin: 0 auto 28px; text-align: center; }
  .MeasureIntro__Title { margin: 0 0 16px; }
  .MeasureIntro__Lead { max-width: 640px; margin: 0 auto; }
  .MeasureIntro__Lead p { line-height: 1.7; }

  .MeasureIntro__Nav {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 12px;
    max-width: 480px; margin: 0 auto 32px;
  }
  .MeasureIntro__Jump { flex: 1 1 auto; }

  .MeasureIntro__Tips {
    max-width: 640px; margin: 0 auto;
    padding: 20px 24px;
    border: 1px solid {{ settings.border_color | default: '#e8e8e8' }};
  }
  .MeasureIntro__Tips ul { margin: 0; padding-left: 20px; }
  .MeasureIntro__Tips li { line-height: 1.7; margin: 0 0 6px; }

  @media (max-width: 640px) {
    .MeasureIntro { padding: 36px 0 4px; }
    .MeasureIntro__Nav { flex-direction: column; }
  }
</style>

{% schema %}
{
  "name": "Measure guide intro",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "richtext",
      "id": "tips",
      "label": "Tips"
    }
  ],
  "presets": [
    {
      "category": "Page",
      "name": "Measure guide intro"
    }
  ]
}
{% endschema %}
