{% schema %}
{
  "name": "Campaign popup",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Enable", "default": false },
    {
      "type": "text", "id": "campaign_id", "label": "Campaign ID", "default": "welcome-oct26",
      "info": "Changing this resets seen / closed / signed-up memory so the new campaign shows again. It is also added to the customer tags."
    },

    { "type": "header", "content": "Content" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select", "id": "image_position", "label": "Image position", "default": "top",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "left", "label": "Left (desktop)" },
        { "value": "none", "label": "None" }
      ]
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "10% off your first piece" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Join the list for first access to new pieces and a welcome gift.</p>" },
    {
      "type": "select", "id": "offer_type", "label": "Offer type", "default": "discount_code",
      "info": "Discount code and Announcement can show a signup form. Link shows a button only.",
      "options": [
        { "value": "discount_code", "label": "Discount code" },
        { "value": "announcement", "label": "Announcement" },
        { "value": "link", "label": "Link" }
      ]
    },
    { "type": "text", "id": "discount_code", "label": "Discount code", "default": "WELCOME10", "info": "Used when Offer type is Discount code." },
    { "type": "text", "id": "button_label", "label": "Form button label", "default": "Get my 10%" },
    { "type": "url", "id": "link_url", "label": "Link URL", "info": "Used when Offer type is Link." },
    { "type": "text", "id": "link_label", "label": "Link button label", "default": "Learn more" },
    { "type": "text", "id": "success_heading", "label": "Success heading", "default": "You're in" },
    { "type": "richtext", "id": "success_text", "label": "Success text", "default": "<p>Here is your code — use it at checkout.</p>" },
    { "type": "text", "id": "shop_now_label", "label": "Shop now label", "default": "Shop now" },
    { "type": "url", "id": "shop_now_link", "label": "Shop now link", "info": "Defaults to /collections/all." },
    {
      "type": "richtext", "id": "legal_text", "label": "Legal text",
      "default": "<p>By signing up you agree to receive emails from AB and Beyond. Unsubscribe anytime. See our <a href='/policies/privacy-policy'>privacy policy</a>.</p>"
    },

    { "type": "header", "content": "Form", "info": "Shown when Offer type is Discount code or Announcement." },
    { "type": "checkbox", "id": "show_form", "label": "Show signup form", "default": true },
    {
      "type": "select", "id": "field_name", "label": "Name field", "default": "required",
      "options": [
        { "value": "hidden", "label": "Hidden" },
        { "value": "optional", "label": "Optional" },
        { "value": "required", "label": "Required" }
      ]
    },
    {
      "type": "select", "id": "field_phone", "label": "Phone field", "default": "required",
      "options": [
        { "value": "hidden", "label": "Hidden" },
        { "value": "optional", "label": "Optional" },
        { "value": "required", "label": "Required" }
      ]
    },
    {
      "type": "select", "id": "field_email", "label": "Email field", "default": "required",
      "info": "The customer form needs an email.",
      "options": [
        { "value": "optional", "label": "Optional" },
        { "value": "required", "label": "Required" }
      ]
    },
    { "type": "checkbox", "id": "show_whatsapp_optin", "label": "Show WhatsApp opt-in", "default": true },
    { "type": "text", "id": "whatsapp_optin_label", "label": "WhatsApp opt-in label", "default": "Also send me updates on WhatsApp" },
    { "type": "text", "id": "customer_tags", "label": "Customer tags", "default": "newsletter,popup-10off", "info": "Comma-separated. The Campaign ID is always added too." },

    { "type": "header", "content": "Look" },
    {
      "type": "select", "id": "desktop_layout", "label": "Desktop layout", "default": "centred",
      "info": "Mobile is always a bottom sheet.",
      "options": [
        { "value": "centred", "label": "Centred modal" },
        { "value": "side_panel_right", "label": "Side panel (right)" }
      ]
    },
    { "type": "range", "id": "max_width", "min": 360, "max": 720, "step": 10, "unit": "px", "label": "Max width", "default": 440 },
    { "type": "paragraph", "content": "Colours default to the theme's popup tokens when left blank." },
    { "type": "color", "id": "bg_color", "label": "Background" },
    { "type": "color", "id": "text_color", "label": "Text" },
    { "type": "color", "id": "accent_color", "label": "Accent / buttons" },

    { "type": "header", "content": "Timing" },
    { "type": "range", "id": "delay_min", "min": 0, "max": 60, "step": 1, "unit": "s", "label": "Minimum delay", "default": 5 },
    { "type": "range", "id": "delay_max", "min": 0, "max": 60, "step": 1, "unit": "s", "label": "Maximum delay", "default": 8 },
    { "type": "range", "id": "dismiss_days", "min": 0, "max": 90, "step": 1, "unit": "d", "label": "Days to stay dismissed", "default": 30, "info": "0 = show again next visit." },
    {
      "type": "select", "id": "frequency", "label": "Frequency", "default": "campaign",
      "options": [
        { "value": "campaign", "label": "Once per campaign" },
        { "value": "session", "label": "Once per session" }
      ]
    },

    { "type": "header", "content": "Targeting" },
    {
      "type": "select", "id": "show_on", "label": "Show on", "default": "all",
      "options": [
        { "value": "all", "label": "All pages" },
        { "value": "home", "label": "Home" },
        { "value": "products", "label": "Products" },
        { "value": "collections", "label": "Collections" },
        { "value": "pages", "label": "Pages" }
      ]
    },
    { "type": "textarea", "id": "include_paths", "label": "Only on these paths", "info": "Optional. One URL path per line (e.g. /pages/gifts). If filled, the popup shows only on these paths." },
    { "type": "text", "id": "exclude_templates", "label": "Exclude templates", "default": "cart, page.book-fitting, page.my-board, customers" },
    {
      "type": "select", "id": "audience", "label": "Audience", "default": "new",
      "options": [
        { "value": "new", "label": "New visitors only" },
        { "value": "all", "label": "Everyone" }
      ]
    },
    { "type": "checkbox", "id": "hide_for_logged_in", "label": "Hide for logged-in customers", "default": true },
    {
      "type": "select", "id": "devices", "label": "Devices", "default": "all",
      "options": [
        { "value": "all", "label": "All" },
        { "value": "mobile", "label": "Mobile only" },
        { "value": "desktop", "label": "Desktop only" }
      ]
    },

    { "type": "header", "content": "Schedule" },
    { "type": "text", "id": "start_date", "label": "Start date", "info": "YYYY-MM-DD, compared in IST. Blank = no limit." },
    { "type": "text", "id": "end_date", "label": "End date", "info": "YYYY-MM-DD, compared in IST. Blank = no limit." },

    { "type": "header", "content": "Editor preview" },
    { "type": "checkbox", "id": "preview_success", "label": "Preview success state", "default": false, "info": "Only affects the theme editor." }
  ],
  "presets": [
    { "name": "Campaign popup" }
  ]
}
{% endschema %}
